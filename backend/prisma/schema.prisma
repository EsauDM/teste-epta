
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  vehicles Vehicles[]
  refreshTokens RefreshToken[]
}

model Vehicles {
  id Int @id @default(autoincrement())
  label String
  model String
  year_of_fabrication Int
  model_year Int
  color String
  fuel_type String
  vehicle_type String
  nickname String?
  picture String?
  plate String
  chassi String
  renavam String

  userId Int
  owner User @relation(fields: [userId], references:[id])
}

model RefreshToken {
  id Int @id @default(autoincrement())
  hashedToken String @unique
  userId Int
  user User @relation(fields: [userId], references:[id], onDelete: Cascade )
  expiresAT DateTime
  createdAT DateTime @default(now())
}
